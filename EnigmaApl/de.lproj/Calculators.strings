// MARK: - JulianDayView
"view.julianday.help"               = "Die Julianische Tageszahl ist eine Methode zur einheitlichen Angabe eines Zeitpunkts in der Astronomie. Ein Julianischer Tag beginnt um 12:00 Uhr UT.\n\nDatum und Uhrzeit können auf die übliche Weise eingegeben werden. Die Julianische Tageszahl wird durch Klicken auf 'Julianischen Tag berechnen' ermittelt.\n\nNeben dem Julianischen Tag wird auch der Wert von Delta T angezeigt, einer Zeitabweichung, die die Berechnung von Planetenstellungen beeinflusst.\n\nWenn du eine Julianische Tageszahl kennst und das entsprechende Datum ermitteln möchtest, kannst du das im unteren Teil des Bildschirms tun.";
"view.julianday.title"              = "Julianischer Tag Rechner";
"view.julianday.datetimetojd"       = "Datum und Uhrzeit zu Julianischem Tag";
"view.julianday.calcbutton"         = "Julianischen Tag berechnen";
"view.julianday.result.jd"          = "Julianischer Tag";
"view.julianday.result.deltat"      = "Delta T";
"view.julianday.todatetime"         = "Julianischer Tag zu Datum und Uhrzeit";
"view.julianday.input"              = "Julianischer Tag";
"view.julianday.calcdatetimebutton" = "Datum und Uhrzeit berechnen";
"view.julianday.result.date"        = "Datum (UT)";
"view.julianday.result.time"        = "Uhrzeit (UT)";

// MARK: - ObliquityView
"view.obliquity.help"               = "Die Neigung der Erdachse ist für eine Vielzahl astronomischer Berechnungen von Bedeutung. Die Veränderungen verlaufen sehr langsam, sind aber relevant, u.a. für die Bestimmung von OOB-Positionen.\n\nGib Datum und Uhrzeit auf die übliche Weise ein. Klicke auf 'Obliquität berechnen' und du siehst zwei Werte: die mittlere Obliquität und die wahre Obliquität. Die wahre Obliquität berücksichtigt die Anziehungskraft des Mondes, die minimale Schwankungen in der Neigung der Erdachse verursacht.";
"view.obliquity.title"              = "Obliquität Rechner";
