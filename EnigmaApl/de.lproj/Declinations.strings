// DeclinationDiagramView
"view.declinationdiagramview.title"                  = "Deklinationsdiagramm";
"view.declinationdiagramview.placeholder"            = "Das Diagramm wird in einer zukünftigen Version verfügbar sein.";
"view.declinationdiagramview.help"                   = "Dieses Diagramm zeigt eine Darstellung der Deklinationen nach dem Vorschlag von Kt. Boehrer. Die horizontale Achse gibt die Länge an, wobei zwischen den Zeichen in der oberen Hälfte und den Zeichen in der unteren Hälfte unterschieden werden muss. Faktoren mit nördlicher Deklination befinden sich oberhalb der horizontalen Linie, Faktoren mit südlicher Deklination unterhalb. Die roten und blauen Kurven zeigen die jährliche Deklination der Sonne. Die Zonen oben und unten im Diagramm (in einem dunklen Blauton) kennzeichnen Out-of-Bounds (OOB)-Positionen. Mit dem Symbol aus kurzen vertikalen Strichen können Positionslinien im Diagramm eingeblendet werden.";
"view.declinationdiagramview.nodata"                 = "Keine Positionsdaten verfügbar.";
"view.declinationdiagramview.col.factor"             = "Faktor";
"view.declinationdiagramview.col.longitude"          = "Längengrad";
"view.declinationdiagramview.col.declination"        = "Deklination";
"view.declinationdiagramview.btn.positionlines"      = "Positionslinien";

