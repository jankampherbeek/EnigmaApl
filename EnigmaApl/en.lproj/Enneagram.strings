"view.enneagramscreen.tab.overview"   = "Overview";
"view.enneagramscreen.tab.details"    = "Details";
"view.enneagramscreen.tab.diagram"    = "Diagram";
"view.enneagramscreen.opt.usehouses"  = "Include houses";
"view.enneagramscreen.opt.doublepluto" = "Count Pluto twice";
