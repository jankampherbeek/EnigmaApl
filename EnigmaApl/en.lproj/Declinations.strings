// AllDeclinationsView
"view.alldeclinationsview.title"                     = "All declinations";
"view.alldeclinationsview.nodata"                    = "No declination data available.";
"view.alldeclinationsview.col.factor"                = "Factor";
"view.alldeclinationsview.col.longitude"             = "Longitude";
"view.alldeclinationsview.col.declination"           = "Declination";
"view.alldeclinationsview.help"                      = "This screen shows the declination for each factor selected in the configuration. On the left you see a graphical overview; the upper part of the figure (dark blue) indicates the Out Of Bounds (OOB) positions.\n\nThe table shows the exact positions. Southern declination is indicated with a minus sign.";

// DeclinationParallelsView
"view.declinationparallelsview.title"                = "Parallels";
"view.declinationparallelsview.nodata"               = "No parallels found.";
"view.declinationparallelsview.help"                 = "This screen shows parallels and contra-parallels. A parallel occurs when two factors have the same declination and the same sign (North or South). A contra-parallel occurs when the declination is equal but the signs differ: one factor has southern declination and one factor has northern declination.";
"view.declinationparallelsview.col.factor1"          = "F1";
"view.declinationparallelsview.col.decl1"            = "Decl 1";
"view.declinationparallelsview.col.aspect"           = "Asp";
"view.declinationparallelsview.col.factor2"          = "F2";
"view.declinationparallelsview.col.decl2"            = "Decl 2";
"view.declinationparallelsview.col.orb"              = "Orb";
"view.declinationparallelsview.col.exactness"        = "Exactness";

// DeclinationLongEquivalentsView
"view.declinationlongequivalentsview.title"          = "Longitude equivalents";
"view.declinationlongequivalentsview.nodata"         = "No longitude equivalents available.";
"view.declinationlongequivalentsview.help"           = "Here you see the longitude equivalent for each factor. This is the position on the ecliptic that corresponds to the declination as if the factor had no latitude. The horoscope chart uses these positions and the table shows the exact values alongside the usual radix positions.";
"view.declinationlongequivalentsview.col.factor"     = "Factor";
"view.declinationlongequivalentsview.col.longitude"  = "Longitude";
"view.declinationlongequivalentsview.col.equivalent" = "Equivalent";

// DeclinationDiagramView
"view.declinationdiagramview.title"                  = "Declination diagram";
"view.declinationdiagramview.placeholder"            = "The diagram will be available in a future version.";
"view.declinationdiagramview.help"                   = "This diagram shows a representation of the declinations as proposed by Kt. Boehrer. The horizontal axis indicates longitude, where you must distinguish between the signs in the upper half and the signs in the lower half. Factors with northern declination are found above the horizontal line and factors with southern declination below it. The red and blue curves show the annual declination of the Sun. The zones at the top and bottom of the diagram (in a dark shade of blue) indicate Out of Bounds (OOB) positions. Using the icon consisting of short vertical lines you can display position lines in the diagram.";
"view.declinationdiagramview.nodata"                 = "No position data available.";
"view.declinationdiagramview.col.factor"             = "Factor";
"view.declinationdiagramview.col.longitude"          = "Longitude";
"view.declinationdiagramview.col.declination"        = "Declination";
"view.declinationdiagramview.btn.positionlines"      = "Position lines";

// DeclinationMidpointsView
"view.declinationmidpointsview.title"                = "Declination midpoints";
"view.declinationmidpointsview.nodata"               = "No occupied declination midpoints found.";
"view.declinationmidpointsview.help"                 = "This screen shows the midpoints in declination, both in a graphical view and in a table. In the figure you can move the mouse over the symbol for a factor to see the midpoints it forms. Clicking locks the lines in place; clicking again makes them disappear.\n\nThe table shows two factors that form a midpoint, the position of the midpoint, the factor occupying the midpoint and its position, the orb, and finally the exactness of that orb.";
"view.declinationmidpointsview.label.north"          = "N";
"view.declinationmidpointsview.label.south"          = "S";
"view.declinationmidpointsview.col.factor1"          = "F1";
"view.declinationmidpointsview.col.decl1"            = "Decl 1";
"view.declinationmidpointsview.col.factor2"          = "F2";
"view.declinationmidpointsview.col.decl2"            = "Decl 2";
"view.declinationmidpointsview.col.midpoint"         = "Midpoint";
"view.declinationmidpointsview.col.occupant"         = "Occ";
"view.declinationmidpointsview.col.occdecl"          = "Occ Decl";
"view.declinationmidpointsview.col.orb"              = "Orb";
