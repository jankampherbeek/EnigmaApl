// VspScreen
"view.vspscreen.title"          = "Venus Star Point";
"view.vspscreen.nochart"        = "Calculate or select a horoscope to view the Venus Star Point.";
"view.vspscreen.explanation"    = "The Venus Star Point (VSP) marks the five positions where Venus conjuncts the Sun in the eight-year Venus cycle, forming a pentagram in the zodiac. The current representation was established in close consultation with Arielle Guttman, who discovered and described this principle.";
"view.vspscreen.help"           = "On the left you see a graphical representation of the Venus Star Point (VSP) positions. The five points indicate the positions where the Sun and Venus are in conjunction. Using the icons you can convert the image to black and white. If the birth time is unknown you can remove the cusps. You can export the drawing in the usual way.\n\nOn the right you see a detailed table with VSP positions. The columns show the sequence in which the positions occur, the name ('Head' is the last position before birth, the positions before and after it are called 'Arms', and the first and last positions are called 'Legs'), the type of conjunction (inferior or superior), the date and time, and the position.";

// Table columns
"view.vspscreen.col.seq"        = "Seq";
"view.vspscreen.col.name"       = "Name";
"view.vspscreen.col.phenomenon" = "Conjunction";
"view.vspscreen.col.date"       = "Date / Time (UT)";
"view.vspscreen.col.longitude"  = "Longitude";

// Position names (pentagram points)
"view.vspscreen.name.leg"       = "Leg";
"view.vspscreen.name.arm"       = "Arm";
"view.vspscreen.name.head"      = "Head";

// Phenomena
"view.vspscreen.phen.inferior"  = "Inferior";
"view.vspscreen.phen.superior"  = "Superior";
