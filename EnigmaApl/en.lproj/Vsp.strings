// VspScreen
"view.vspscreen.title"          = "Venus Star Point";
"view.vspscreen.nochart"        = "Calculate or select a horoscope to view the Venus Star Point.";
"view.vspscreen.explanation"    = "The Venus Star Point (VSP) marks the five positions where Venus conjuncts the Sun in the eight-year Venus cycle, forming a pentagram in the zodiac. The current representation was established in close consultation with Arielle Guttman, who discovered and described this principle.";
"view.vspscreen.help"           = "The Venus Star Point screen shows the five positions where Venus conjuncts the Sun in the eight-year Venus cycle. These five points form a perfect pentagram in the zodiac.\n\nEach row shows:\n– Seq: the chronological sequence number (1–5)\n– Name: the point on the pentagram (Head, Arm, Leg)\n– Conjunction: whether the conjunction is inferior (Venus between Earth and Sun) or superior (Sun between Earth and Venus)\n– Date / Time: the exact date and time of the conjunction in UT\n– Longitude: the ecliptical longitude at that moment\n\nThe pentagram connection sequence is 1 → 3 → 5 → 2 → 4.";

// Table columns
"view.vspscreen.col.seq"        = "Seq";
