// ImportExport.strings - English
// EnigmaApl

"view.importexport.title"  = "Import / Export";
"view.importexport.select" = "Select a format from the list to import or export charts and events.";

"view.importexport.detail.title" = "%@";

"view.importexport.enigma.body" = "Export all charts and events to a JSON file, or import charts and events from a previously exported file. Calculated positions are not included; they are recalculated from the imported data.";
"view.importexport.enigma.export.button" = "Export…";
"view.importexport.enigma.import.button" = "Import…";
"view.importexport.enigma.export.success" = "Exported %d charts and %d events.";
"view.importexport.enigma.import.success" = "Imported %d charts and %d events (skipped %d charts and %d events already present).";

"view.importexport.warnings.header" = "Warnings";

"view.importexport.qck.body" = "Export all charts to a Quick*Chart (.qck) file, or import charts from one. QCK is a legacy fixed-width format: long names/places are truncated and the original timezone identity is not preserved, though the represented moment in time always is. See the warnings below for anything affected.";
"view.importexport.qck.export.button" = "Export…";
"view.importexport.qck.import.button" = "Import…";
"view.importexport.qck.export.success" = "Exported %d charts.";
"view.importexport.qck.import.success" = "Imported %d charts.";
"view.importexport.qck.record.message" = "Record %d: %@";

"view.importexport.aaf.body" = "Export all charts to an AAF'97 (Astrological Exchange Format) file, or import charts from one. AAF's event/country/organisation record types are kept as a chart category, since Enigma events must already be linked to an existing chart. Positions, houses and aspects are not read or written; Enigma recalculates them from the imported date, time and place.";
"view.importexport.aaf.export.button" = "Export…";
"view.importexport.aaf.import.button" = "Import…";
"view.importexport.aaf.export.success" = "Exported %d charts.";
"view.importexport.aaf.import.success" = "Imported %d charts.";
"view.importexport.aaf.record.message" = "Record %d: %@";

"view.importexport.adb.body" = "Import charts from an Astro.com / Astro-Databank XML export (format 160715). This format is import-only; Enigma does not export to it.";
"view.importexport.adb.import.button" = "Import…";
"view.importexport.adb.import.success" = "Imported %d charts.";
"view.importexport.adb.record.message" = "Entry %d: %@";
