"view.julianday.result.deltat"      = "Delta T";
"view.julianday.todatetime"         = "Jour Julien vers date et heure";
"view.julianday.input"              = "Jour Julien";
"view.julianday.calcdatetimebutton" = "Calculer la date et l'heure";
